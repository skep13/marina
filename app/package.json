{
  "name": "marina",
  "version": "1.0.0",
  "description": "Transparent desktop VRM avatar assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux dir",
    "appimage": "electron-builder --linux AppImage"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "three": "^0.185.1"
  },
  "productName": "Marina",
  "build": {
    "appId": "com.jacobmatthews.marina",
    "productName": "Marina",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "models/**/*",
      "assets/**/*",
      "!test/**",
      "!src/**",
      "!build/**"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "executableName": "marina",
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "Transparent desktop VRM avatar assistant",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "Marina-${version}-${arch}.AppImage"
    },
    "afterPack": "build/afterPack.js"
  },
  "author": "Jacob Matthews"
}
