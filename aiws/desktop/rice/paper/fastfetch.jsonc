// Paper fastfetch: braille logo of the wallpaper, colours from palette.json
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/paper-ascii.ansi",
    "type": "file-raw",
    "width": 40,
    "height": 22,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "green",
      "title": "red",
      "separator": "white"
    },
    "key": {
      "width": 9
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "width": 12,
      "color": {
        "elapsed": "green",
        "total": "white"
      }
    },
    "percent": {
      "type": [
        "num",
        "bar"
      ],
      "color": {
        "green": "green",
        "yellow": "yellow",
        "red": "red"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "✦ {user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[37m─────────────────────────────"
    },
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "host",
      "key": "host"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "shell",
      "key": "shell"
    },
    {
      "type": "terminal",
      "key": "term"
    },
    {
      "type": "cpu",
      "key": "cpu"
    },
    {
      "type": "memory",
      "key": "memory"
    },
    {
      "type": "swap",
      "key": "swap"
    },
    {
      "type": "disk",
      "key": "disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "battery",
      "key": "battery",
      "format": "{capacity-bar} {capacity}{?time-hours} · {time-hours}h {time-minutes}m left{?}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
