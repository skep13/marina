#!/usr/bin/env python3
"""Rectangle-style window snapping for Hyprland.

  snap-window left|right|top|bottom          halves
  snap-window tl|tr|bl|br                    quarters
  snap-window first-third|center-third|last-third
  snap-window first-two-thirds|last-two-thirds
  snap-window max|center|restore

Floats the focused window and places it exactly in the usable area of
its monitor (inside Caelestia's bar and any other reserved space), with a
gap like Hyprland's own. `restore` puts it back into tiling.
"""
import json
import subprocess
import sys

GAP = 10


def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True, check=True).stdout


def dispatch_lua(calls):
    """Hyprland 0.55+ with a Lua config: `hyprctl dispatch 'hl.dsp...'`.
    Returns False if this Hyprland doesn't take Lua dispatchers."""
    for call in calls:
        r = subprocess.run(["hyprctl", "dispatch", call], capture_output=True, text=True)
        if r.returncode != 0 or "error" in (r.stdout + r.stderr).lower():
            return False
    return True


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    pos = sys.argv[1]
    win = json.loads(hypr("activewindow", "-j") or "{}")
    if not win:
        return
    addr = f"address:{win['address']}"
    if pos == "restore":
        if win.get("floating") and not dispatch_lua(
                [f'hl.dsp.window.float({{ action = "disable", window = "{addr}" }})']):
            hypr("dispatch", "settiled", addr)
        return

    mon = next(m for m in json.loads(hypr("monitors", "-j")) if m["id"] == win["monitor"])
    scale = mon.get("scale", 1) or 1
    rl, rt, rr, rb = mon.get("reserved", [0, 0, 0, 0])
    # Usable area in global logical pixels.
    x0 = mon["x"] + rl + GAP
    y0 = mon["y"] + rt + GAP
    w = round(mon["width"] / scale) - rl - rr - 2 * GAP
    h = round(mon["height"] / scale) - rt - rb - 2 * GAP
    hw, hh = (w - GAP) // 2, (h - GAP) // 2
    tw = (w - 2 * GAP) // 3

    if pos == "center":
        cw, ch = win["size"]
        cw, ch = min(cw, w), min(ch, h)
        rect = (x0 + (w - cw) // 2, y0 + (h - ch) // 2, cw, ch)
    else:
        rect = {
            "max": (x0, y0, w, h),
            "left": (x0, y0, hw, h),
            "right": (x0 + hw + GAP, y0, w - hw - GAP, h),
            "top": (x0, y0, w, hh),
            "bottom": (x0, y0 + hh + GAP, w, h - hh - GAP),
            "tl": (x0, y0, hw, hh),
            "tr": (x0 + hw + GAP, y0, w - hw - GAP, hh),
            "bl": (x0, y0 + hh + GAP, hw, h - hh - GAP),
            "br": (x0 + hw + GAP, y0 + hh + GAP, w - hw - GAP, h - hh - GAP),
            "first-third": (x0, y0, tw, h),
            "center-third": (x0 + tw + GAP, y0, tw, h),
            "last-third": (x0 + 2 * (tw + GAP), y0, w - 2 * (tw + GAP), h),
            "first-two-thirds": (x0, y0, 2 * tw + GAP, h),
            "last-two-thirds": (x0 + tw + GAP, y0, w - tw - GAP, h),
        }.get(pos)
        if rect is None:
            sys.exit(f"unknown position {pos!r}\n\n{__doc__}")

    x, y, rw, rh = rect
    sel = f'window = "{addr}"'
    lua = []
    if not win.get("floating"):
        lua.append(f'hl.dsp.window.float({{ action = "enable", {sel} }})')
    lua += [f"hl.dsp.window.resize({{ x = {rw}, y = {rh}, exact = true, {sel} }})",
            f"hl.dsp.window.move({{ x = {x}, y = {y}, exact = true, {sel} }})"]
    if not dispatch_lua(lua):              # Hyprland before the Lua config
        cmds = [] if win.get("floating") else [f"dispatch setfloating {addr}"]
        cmds += [f"dispatch resizewindowpixel exact {rw} {rh},{addr}",
                 f"dispatch movewindowpixel exact {x} {y},{addr}"]
        hypr("--batch", "; ".join(cmds))


if __name__ == "__main__":
    main()
