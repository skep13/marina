#!/usr/bin/env python3
"""Give each keyboard zone its own solid colour.

  kbd-split                          apply the saved split (if any)
  kbd-split LEFT RIGHT [brightness]  left half one colour, right half another
  kbd-split W A N P [brightness]     all four zones: WASD, main keys, nav, numpad
  kbd-split clear                    forget the split (back to one colour)

The MSI keyboard has four zones, left to right: WASD, the main keys, the
arrows/nav block and the numpad. LightShow's "static" look only does one
colour for the whole board, so this writes the zones directly through
LightShow's own driver and remembers the split in
~/.local/state/kbd-split.json, which kbd-mode reapplies after the Claude
wave and after the idle lights-off.
"""
import json
import os
import sys
import urllib.request

sys.path.insert(0, os.path.expanduser("~/.local/src/lightshow"))
from lightshow import kbd  # noqa: E402

SAVED = os.path.expanduser("~/.local/state/kbd-split.json")
API = "http://127.0.0.1:8787/api"
ZONE_MASKS = (1, 2, 4, 8)            # WASD, main keys, nav, numpad (left to right)


def rgb(hexc):
    h = hexc.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def tell_lightshow(first):
    """Leave LightShow on a solid look so it doesn't animate over the split."""
    body = json.dumps({"effect": "static", "brightness": 1.0, "speed": 1.0}).encode()
    try:
        urllib.request.urlopen(urllib.request.Request(API + "/apply", data=body,
                               headers={"Content-Type": "application/json"}), timeout=2)
    except OSError:
        pass


def write(zones, brightness):
    kb = kbd.Keyboard()
    try:
        for mask, colour in zip(ZONE_MASKS, zones):
            r, g, b = (round(c * brightness) for c in rgb(colour))
            kb.set(mask, kbd.MODE_STATIC, [(0, r, g, b)])
    finally:
        kb.close()


def main():
    args = sys.argv[1:]
    if args == ["clear"]:
        if os.path.exists(SAVED):
            os.remove(SAVED)
        return
    if not args:
        if not os.path.exists(SAVED):
            return
        look = json.load(open(SAVED))
    else:
        bright = 1.0
        if len(args) in (3, 5):
            bright = float(args.pop())
        zones = [args[0], args[0], args[1], args[1]] if len(args) == 2 else args[:4]
        look = {"zones": zones, "brightness": bright}
        os.makedirs(os.path.dirname(SAVED), exist_ok=True)
        json.dump(look, open(SAVED, "w"))
    tell_lightshow(look["zones"][0])
    write(look["zones"], look["brightness"])


if __name__ == "__main__":
    main()
