// Miku fastfetch — braille dot illustration of the wallpaper as the logo
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/miku-ascii.ansi",
    "type": "file-raw",
    "width": 44,
    "height": 22,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta", "separator": "blue" },
    "key": { "width": 9 },
    "bar": { "char": { "elapsed": "━", "total": "─" }, "width": 12, "color": { "elapsed": "blue", "total": "black" } },
    "percent": { "type": ["num", "bar"], "color": { "green": "blue", "yellow": "magenta", "red": "red" } }
  },
  "modules": [
    { "type": "title", "format": "✿ {user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[34m─────────────────────────────" },
    { "type": "os", "key": "os" },
    { "type": "host", "key": "host" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "shell", "key": "shell" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu", "key": "cpu" },
    { "type": "memory", "key": "memory" },
    { "type": "swap", "key": "swap" },
    { "type": "disk", "key": "disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery", "key": "battery", "format": "{capacity-bar} {capacity}{?time-hours} · {time-hours}h {time-minutes}m left{?}" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
