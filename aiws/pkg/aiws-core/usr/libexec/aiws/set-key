#!/bin/sh
# Save lab3's llama-swap key (read from stdin) into /etc/aiws/secrets.env and
# restart the gateway. Run through pkexec by Marina's first-boot card.
set -eu
[ "$(id -u)" = 0 ] || { echo "needs root" >&2; exit 1; }
read -r key
case "$key" in *[!A-Za-z0-9_.-]*|"") echo "that doesn't look like a key" >&2; exit 2;; esac
f=/etc/aiws/secrets.env
touch "$f"; chown root:aiws "$f"; chmod 640 "$f"
grep -v '^AIWS_KEY_LAB3=' "$f" > "$f.tmp" || true
printf 'AIWS_KEY_LAB3=%s\n' "$key" >> "$f.tmp"
cat "$f.tmp" > "$f"; rm -f "$f.tmp"
systemctl try-restart aiwsd.service
