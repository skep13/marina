#!/bin/sh
set -e
if [ "$1" = configure ]; then
  getent group aiws >/dev/null || addgroup --system aiws
  getent passwd aiws >/dev/null || adduser --system --ingroup aiws --home /var/lib/aiws \
    --no-create-home --shell /usr/sbin/nologin aiws
  for g in render video; do getent group $g >/dev/null && adduser aiws $g >/dev/null || true; done
  install -d -o aiws -g aiws -m 0750 /var/lib/aiws /var/lib/aiws/ssh
  install -d -o aiws -g aiws -m 0755 /var/lib/aiws/models
  [ -f /etc/aiws/secrets.env ] || install -o root -g aiws -m 0640 /dev/null /etc/aiws/secrets.env
  # New desktop users join group aiws (reads the desktop token).
  if [ -f /etc/adduser.conf ] && ! grep -q '^EXTRA_GROUPS=.*aiws' /etc/adduser.conf; then
    sed -i 's/^#\?ADD_EXTRA_GROUPS=.*/ADD_EXTRA_GROUPS=1/' /etc/adduser.conf
    if grep -q '^EXTRA_GROUPS=' /etc/adduser.conf; then
      sed -i 's/^EXTRA_GROUPS="\(.*\)"/EXTRA_GROUPS="\1 aiws"/' /etc/adduser.conf
    else
      echo 'EXTRA_GROUPS="users aiws"' >> /etc/adduser.conf
    fi
  fi
  # Existing human users too.
  for u in $(getent passwd | awk -F: '$3>=1000 && $3<60000 {print $1}'); do adduser "$u" aiws >/dev/null || true; done
fi
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
  systemctl enable --now llama-swap.service aiwsd.service || true
else
  systemctl enable llama-swap.service aiwsd.service || true
fi
