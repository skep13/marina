[Unit]
Description=AIWS: model gateway, projects, jobs and the control centre
After=network-online.target
Wants=network-online.target llama-swap.service

[Service]
User=aiws
Group=aiws
EnvironmentFile=-/etc/default/aiwsd
# Per-machine job key, made on first start (never baked into the image).
ExecStartPre=/bin/sh -c 'test -f /var/lib/aiws/ssh/id_ed25519 || ssh-keygen -q -t ed25519 -N "" -C "aiws@%H" -f /var/lib/aiws/ssh/id_ed25519'
ExecStart=/usr/bin/aiwsd
Restart=on-failure
Slice=aiws.slice
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/aiws
PrivateTmp=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
