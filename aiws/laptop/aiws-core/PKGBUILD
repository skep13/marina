# AI workstation core for Arch / CachyOS, built from this checkout.
#   cd aiws/laptop/aiws-core && makepkg -si
pkgname=aiws-core
pkgver=0.1.0
pkgrel=1
pkgdesc="AI workstation: Marina's sphere, model gateway, assistant, ai CLI, Control Centre"
arch=(any)
license=(custom)
options=(!debug)
depends=(python python-fastapi uvicorn python-httpx python-yaml python-gobject
         gtk3 webkit2gtk-4.1 python-atspi at-spi2-core grim wtype wl-clipboard ydotool
         tmux openssh sqlite electron)
optdepends=('llama-swap: run local models'
            'hyprland: the desktop (Caelestia); keybindings in /usr/share/aiws/hypr'
            'xdotool: X11 sessions instead of Hyprland'
            'podman: isolated project environments'
            'distrobox: per-project toolboxes')
backup=(etc/aiws/aiws.yaml etc/aiws/secrets.env)
install=aiws-core.install

_root="$startdir/../.."

package() {
  local site
  site=$(python -c 'import site; print(site.getsitepackages()[0])')
  install -d "$pkgdir$site"
  cp -r "$_root/src/aiws" "$pkgdir$site/"
  find "$pkgdir$site/aiws" -name __pycache__ -prune -exec rm -rf {} +

  cd "$_root/pkg/aiws-core"
  install -Dm755 -t "$pkgdir/usr/bin" usr/bin/ai usr/bin/aiwsd usr/bin/aiws-agent \
    usr/bin/ai-ask usr/bin/aiws-control usr/bin/aiws-panel usr/bin/aiws-orb
  install -Dm755 "$_root/tools/ai-bench" "$pkgdir/usr/bin/ai-bench"
  install -Dm755 "$_root/tools/ai-mem" "$pkgdir/usr/bin/ai-mem"
  install -Dm755 "$startdir/../aiws-user-setup" "$pkgdir/usr/bin/aiws-user-setup"
  install -Dm755 usr/libexec/aiws/session-setup "$pkgdir/usr/lib/aiws/session-setup"
  install -Dm755 usr/libexec/aiws/set-key "$pkgdir/usr/lib/aiws/set-key"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" lib/systemd/system/*
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" usr/lib/systemd/user/aiws-agent.service
  install -Dm644 -t "$pkgdir/usr/share/applications" usr/share/applications/*.desktop
  install -Dm644 "$_root/desktop/hypr/aiws.lua" "$pkgdir/usr/share/aiws/hypr/aiws.lua"
  cp -r "$_root/examples" "$pkgdir/usr/share/aiws/"
  install -d "$pkgdir/usr/lib/aiws/orb"
  cp -r "$_root/orb/package.json" "$_root/orb/main.js" "$_root/orb/preload.js" "$_root/orb/renderer" \
    "$pkgdir/usr/lib/aiws/orb/"
  install -Dm644 -t "$pkgdir/usr/share/doc/aiws" "$_root/docs/"*.md

  install -Dm644 "$startdir/90-aiws-accessibility.conf" "$pkgdir/usr/lib/environment.d/90-aiws-accessibility.conf"
  install -Dm644 "$startdir/60-aiws-uinput.rules" "$pkgdir/usr/lib/udev/rules.d/60-aiws-uinput.rules"
  install -Dm644 "$startdir/aiws.sysusers" "$pkgdir/usr/lib/sysusers.d/aiws.conf"
  install -Dm644 "$startdir/aiws.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/aiws.conf"
  cd "$startdir/../etc/aiws"
  install -Dm644 aiws.yaml "$pkgdir/etc/aiws/aiws.yaml"
  install -Dm640 /dev/null "$pkgdir/etc/aiws/secrets.env"
  install -Dm644 -t "$pkgdir/etc/aiws/models.d" models.d/*.yaml
  install -Dm644 -t "$pkgdir/etc/aiws/workers.d" workers.d/*
}
