#!/bin/sh
# Pick the power mode from the charger: plugged in gets MSI Turbo and the
# performance profile; on battery, MSI Eco and power-saver (less heat, less
# fan wear, longer battery). Run by power-auto.service at boot and whenever
# the charger is connected or removed (90-power-auto.rules).
if [ "$(cat /sys/class/power_supply/ADP1/online 2>/dev/null)" = 1 ]; then
  shift=turbo; profile=performance
else
  shift=eco; profile=power-saver
fi
[ -w /sys/devices/platform/msi-ec/shift_mode ] && echo "$shift" > /sys/devices/platform/msi-ec/shift_mode
powerprofilesctl set "$profile" 2>/dev/null || true
logger -t power-auto "charger $(cat /sys/class/power_supply/ADP1/online 2>/dev/null): $shift / $profile"
