#!/usr/bin/env python3
"""Give a controller's sticks a deadzone, to hide stick drift.

  dualsense-deadzone /dev/input/eventN [percent]     (default 9)

Sets the kernel's "flat" value on the four stick axes, which SDL (and so
most native and Proton-less games) treats as the deadzone: anything inside it
reads as centred. Run by 72-dualsense-deadzone.rules whenever the pad
connects. Steam Input has its own deadzone setting for Steam games.
"""
import fcntl
import os
import struct
import sys

STICKS = (0, 1, 3, 4)              # ABS_X, ABS_Y, ABS_RX, ABS_RY


def main():
    dev = sys.argv[1]
    percent = float(sys.argv[2]) if len(sys.argv) > 2 else 9.0
    fd = os.open(dev, os.O_RDONLY)
    try:
        for code in STICKS:
            buf = bytearray(24)
            fcntl.ioctl(fd, 0x80184540 + code, buf)        # EVIOCGABS
            value, lo, hi, fuzz, flat, res = struct.unpack("6i", buf)
            flat = round((hi - lo) / 2 * percent / 100)
            fcntl.ioctl(fd, 0x401845C0 + code,             # EVIOCSABS
                        struct.pack("6i", value, lo, hi, fuzz, flat, res))
    finally:
        os.close(fd)


if __name__ == "__main__":
    main()
