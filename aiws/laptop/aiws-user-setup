#!/bin/bash
# Per-user setup for the AI workstation laptop: Caelestia's dotfiles, the
# Miku rice from the Mac, Marina's keys. No prompts, works offline.
#
# Run as the user (the installer does this for the account it creates):
#   aiws-user-setup [--offline]
#
# Reads everything from /usr/share/aiws (put there by the installer):
#   tree/desktop/rice, tree/desktop/hypr, tree/vendor/{ohmyzsh,caelestia-dots}
#   miku-assets.tar.gz  (wallpapers, Anurati + Inter fonts, fastfetch logo)
# Existing files it would replace are kept as <file>.before-miku.
set -uo pipefail
SHARE=/usr/share/aiws
TREE=$SHARE/tree
RICE=$TREE/desktop/rice
CFG=${XDG_CONFIG_HOME:-$HOME/.config}
say() { printf '== %s\n' "$*"; }

put() {
  mkdir -p "$(dirname "$2")"
  if [ -f "$2" ] && ! cmp -s "$1" "$2"; then
    [ -f "$2.before-miku" ] || cp "$2" "$2.before-miku"
  fi
  install -m "${3:-644}" "$1" "$2"
}

say "Caelestia dotfiles (hypr, uwsm, foot, btop, thunar)"
dots=$TREE/vendor/caelestia-dots
for c in hypr uwsm foot btop thunar; do
  src=$dots/$c; [ "$c" = thunar ] && dest=$CFG/Thunar || dest=$CFG/$c
  [ -d "$src" ] || continue
  mkdir -p "$dest" && cp -rn "$src/." "$dest/"
done
mkdir -p "$CFG/caelestia"
[ -s "$CFG/caelestia/hypr-vars.lua" ] || printf 'return {\n    terminal = "kitty",\n}\n' > "$CFG/caelestia/hypr-vars.lua"
touch "$CFG/caelestia/hypr-user.lua"

say "Marina's keys and the rice's snapping in Hyprland"
for line in 'dofile("/usr/share/aiws/hypr/aiws.lua")' \
            'dofile(os.getenv("HOME") .. "/.config/miku-theme/rice.lua")'; do
  grep -qF "$line" "$CFG/caelestia/hypr-user.lua" || printf '%s\n' "$line" >> "$CFG/caelestia/hypr-user.lua"
done

say "Wallpapers, fonts, fastfetch logo"
if [ -f "$SHARE/miku-assets.tar.gz" ]; then
  tmp=$(mktemp -d); tar -xzf "$SHARE/miku-assets.tar.gz" -C "$tmp"
  mkdir -p "$HOME/.local/share/fonts" "$HOME/Pictures/Wallpapers" "$CFG/fastfetch"
  cp "$tmp"/miku-assets/fonts/* "$HOME/.local/share/fonts/"
  cp "$tmp"/miku-assets/wallpapers/* "$HOME/Pictures/Wallpapers/"
  cp "$tmp"/miku-assets/fastfetch/miku-ascii.ansi "$CFG/fastfetch/"
  rm -rf "$tmp"
  command -v fc-cache >/dev/null && fc-cache -f >/dev/null 2>&1
fi

say "Shell, terminal and the rest of the rice"
[ -d "$HOME/.oh-my-zsh" ] || cp -r "$TREE/vendor/ohmyzsh" "$HOME/.oh-my-zsh"
put "$RICE/kitty/kitty.conf"        "$CFG/kitty/kitty.conf"
put "$RICE/zsh/zshrc"               "$HOME/.zshrc"
put "$RICE/zsh/miku.zsh"            "$CFG/miku-theme/miku.zsh"
put "$RICE/zsh/miku.zsh-theme"      "$HOME/.oh-my-zsh/custom/themes/miku.zsh-theme"
put "$RICE/fastfetch/config.jsonc"  "$CFG/fastfetch/config.jsonc"
put "$RICE/cava/config"             "$CFG/cava/config"
put "$RICE/mond/shell.qml"          "$CFG/quickshell/mond/shell.qml"
put "$RICE/mond/stats.sh"           "$CFG/quickshell/mond/stats.sh" 755
put "$RICE/hypr/snap-window"        "$HOME/.local/bin/snap-window" 755
put "$RICE/hypr/rice.lua"           "$CFG/miku-theme/rice.lua"
put "$TREE/desktop/firstlogin.sh"   "$HOME/.local/bin/aiws-firstlogin" 755

say "Done. First login finishes the parts that need a running session."
