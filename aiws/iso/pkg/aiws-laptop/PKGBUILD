# Everything the laptop gets on top of CachyOS, as one package to install.
# From the normal Arch/CachyOS repos except aiws-core, llama-swap and the
# Caelestia packages, which come from the ISO's own repo.
pkgname=aiws-laptop
pkgver=0.1.0
pkgrel=1
pkgdesc="AI workstation laptop: Marina, Caelestia on Hyprland, the Miku rice, apps"
arch=(any)
license=(custom)
options=(!debug)
depends=(
  # ours
  aiws-core llama-swap
  # desktop: Hyprland + Caelestia (components hypr, uwsm, foot, btop, thunar)
  hyprland xdg-desktop-portal-hyprland xdg-desktop-portal-gtk uwsm
  caelestia-shell caelestia-cli foot btop thunar
  ttf-jetbrains-mono-nerd ttf-cascadia-code-nerd ttf-material-symbols-variable
  # the rice
  kitty zsh fastfetch cava pipewire-jack ttf-dejavu inter-font   # qs comes with caelestia-shell (quickshell-git)
  # network
  tailscale
  # college, dev, hardware
  libreoffice-fresh firefox thunderbird vscodium
  python-pip python-virtualenv nodejs npm git
  esptool arduino-cli platformio-core kicad blender prismlauncher
  podman distrobox
)
optdepends=('orca-slicer: 3D printing slicer (AUR)'
            'llama.cpp-cuda: local models on the RTX 5050 (AUR)')
