#!/bin/bash
# Adds the AI workstation to a freshly installed CachyOS system.
# Called by the installer (shellprocess@aiws) as:  aiws-install-target ROOT USER
#
#   1. our package repo from this ISO -> the new system, then install the
#      aiws-laptop meta package (our packages + Caelestia + apps; the rest
#      comes from the normal CachyOS/Arch mirrors, the install is online)
#   2. the Miku assets and setup files -> /usr/share/aiws
#   3. per-user setup for USER: shell, kitty, fastfetch, cava, Mond clock,
#      Caelestia keys + snapping, groups
#   4. services: aiwsd, llama-swap, tailscaled
# Secrets (the lab3 key, the Tailscale login) are NOT on the ISO: Marina asks
# for them on first boot.
set -uo pipefail
ROOT=${1:?root}; USER_NAME=${2:?user}
LOG="$ROOT/var/log/aiws-install.log"
mkdir -p "$(dirname "$LOG")"
exec > >(tee -a "$LOG") 2>&1
echo "== aiws-install-target $(date) root=$ROOT user=$USER_NAME"
SRC=/opt/aiws

in_root() { arch-chroot "$ROOT" "$@"; }

# 1. packages
mkdir -p "$ROOT/var/cache/aiws-repo"
cp -a "$SRC/repo/." "$ROOT/var/cache/aiws-repo/"
if ! grep -q '^\[aiws\]' "$ROOT/etc/pacman.conf"; then
  printf '\n# AI workstation packages from the install ISO\n[aiws]\nSigLevel = Optional TrustAll\nServer = file:///var/cache/aiws-repo\n' >> "$ROOT/etc/pacman.conf"
fi
in_root pacman -Sy --noconfirm --needed aiws-laptop || echo "!! package install failed; see above"

# 2. assets and setup files
mkdir -p "$ROOT/usr/share/aiws"
cp -a "$SRC/miku-assets.tar.gz" "$SRC/tree" "$ROOT/usr/share/aiws/" 2>/dev/null

# 3. the user
for g in aiws input uucp video render; do in_root gpasswd -a "$USER_NAME" "$g" >/dev/null 2>&1; done
in_root runuser -u "$USER_NAME" -- /usr/bin/aiws-user-setup --offline || echo "!! user setup failed; run aiws-user-setup after login"

# 4. services
in_root systemctl enable aiwsd.service llama-swap.service tailscaled.service
echo "== done"
