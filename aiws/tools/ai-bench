#!/usr/bin/env python3
"""Benchmark an OpenAI-compatible endpoint the way a workstation uses it.

Measures, per scenario and over several runs:
  ttft_s        time to first streamed token, from the client
  prompt_tps    prompt processing speed (llama.cpp timings when available)
  gen_tps       generation speed
  wall_s        whole request

Stdlib only, so it runs on the Mac, on a Proxmox host and inside the image.

  AIWS_API_KEY=... ai-bench --base http://192.168.1.15:8080 --model marina
  ai-bench ... --json bench/results/lab3-baseline.json

Scenarios are fixed so results stay comparable between deployments. A
fresh nonce leads every prompt so the server's prompt cache can't hide
prompt processing.
"""
import argparse
import json
import os
import statistics
import sys
import time
import urllib.request
import uuid

FILLER = ("The workstation keeps a list of projects, models and jobs. "
          "Each project remembers its repositories, terminals and tools. ")

CODE = '''def merge(a, b):
    out = []
    i = j = 0
    while i < len(a) and j < len(b):
        if a[i] < b[j]:
            out.append(a[i]); i += 1
        else:
            out.append(b[j]); j += 1
    return out
'''

SCENARIOS = {
    # Chat turn: short prompt, short answer.
    "chat": ("Say hello in one sentence.", 48),
    # Coding: read a small function, explain and fix the bug.
    "code": ("This merge drops the tail of one list. Fix it and show the "
             "corrected function only.\n\n" + CODE, 256),
    # Context-heavy: about 2k tokens of project context, short answer.
    "context-2k": (FILLER * 90 + "\n\nIn five words, what does the "
                   "workstation remember per project?", 32),
    # Long context: about 8k tokens.
    "context-8k": (FILLER * 360 + "\n\nAnswer with one word: what does "
                   "the workstation keep a list of?", 16),
}


def stream(base, key, model, prompt, max_tokens, timeout):
    body = {
        "model": model,
        "messages": [{"role": "user", "content": f"[{uuid.uuid4().hex[:8]}] {prompt}"}],
        "max_tokens": max_tokens,
        "temperature": 0,
        "stream": True,
        "stream_options": {"include_usage": True},
        # Qwen3 / Gemma 4 thinking would skew generation counts.
        "chat_template_kwargs": {"enable_thinking": False},
    }
    headers = {"Content-Type": "application/json"}
    if key:
        headers["Authorization"] = f"Bearer {key}"
    req = urllib.request.Request(f"{base}/v1/chat/completions",
                                 json.dumps(body).encode(), headers)
    t0 = time.perf_counter()
    ttft = None
    timings = usage = None
    text = []
    with urllib.request.urlopen(req, timeout=timeout) as r:
        for raw in r:
            line = raw.decode("utf-8", "replace").strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            ev = json.loads(data)
            for ch in ev.get("choices") or []:
                delta = (ch.get("delta") or {})
                piece = delta.get("content") or delta.get("reasoning_content")
                if piece:
                    if ttft is None:
                        ttft = time.perf_counter() - t0
                    text.append(piece)
            timings = ev.get("timings") or timings
            usage = ev.get("usage") or usage
    wall = time.perf_counter() - t0
    out = {"ttft_s": ttft, "wall_s": wall, "chars": len("".join(text))}
    if timings:
        out.update(prompt_n=timings.get("prompt_n"),
                   prompt_tps=timings.get("prompt_per_second"),
                   gen_n=timings.get("predicted_n"),
                   gen_tps=timings.get("predicted_per_second"))
    elif usage:
        n = usage.get("completion_tokens") or 0
        gen_time = wall - (ttft or 0)
        out.update(prompt_n=usage.get("prompt_tokens"), gen_n=n,
                   gen_tps=(n - 1) / gen_time if n > 1 and gen_time > 0 else None)
    return out


def summarise(runs):
    keys = ["ttft_s", "prompt_tps", "gen_tps", "wall_s", "prompt_n", "gen_n"]
    s = {}
    for k in keys:
        vals = [r[k] for r in runs if r.get(k) is not None]
        if vals:
            s[k] = round(statistics.median(vals), 3)
    return s


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--base", required=True, help="server root, without /v1")
    ap.add_argument("--model", required=True)
    ap.add_argument("--key", default=os.environ.get("AIWS_API_KEY", ""))
    ap.add_argument("--runs", type=int, default=3)
    ap.add_argument("--scenarios", default=",".join(SCENARIOS))
    ap.add_argument("--label", default="")
    ap.add_argument("--timeout", type=float, default=900)
    ap.add_argument("--json", help="write results here")
    a = ap.parse_args()
    base = a.base.rstrip("/").removesuffix("/v1")

    # Warm-up: make sure the model is loaded so the first scenario doesn't
    # include a cold load. The load itself is reported separately.
    t0 = time.perf_counter()
    stream(base, a.key, a.model, "ok", 1, a.timeout)
    warm = time.perf_counter() - t0
    print(f"{a.model} @ {base}  warm-up {warm:.2f}s\n")
    print(f"{'scenario':<12}{'ttft s':>9}{'pp t/s':>10}{'tg t/s':>9}{'wall s':>9}{'prompt':>8}")

    results = {"label": a.label, "base": base, "model": a.model,
               "when": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
               "warmup_s": round(warm, 3), "scenarios": {}}
    for name in a.scenarios.split(","):
        prompt, n = SCENARIOS[name]
        runs = []
        for _ in range(a.runs):
            try:
                runs.append(stream(base, a.key, a.model, prompt, n, a.timeout))
            except Exception as e:  # keep going; report the failure
                print(f"{name}: {e}", file=sys.stderr)
        s = summarise(runs)
        results["scenarios"][name] = {"median": s, "runs": runs}
        f = lambda k, w, p=2: (f"{s[k]:>{w}.{p}f}" if k in s else f"{'-':>{w}}")
        print(f"{name:<12}{f('ttft_s', 9)}{f('prompt_tps', 10, 1)}"
              f"{f('gen_tps', 9, 1)}{f('wall_s', 9)}{s.get('prompt_n', '-'):>8}")
    if a.json:
        with open(a.json, "w") as fh:
            json.dump(results, fh, indent=2)
        print(f"\nwrote {a.json}")


if __name__ == "__main__":
    main()
