#!/bin/sh
# Calamares: the installed user joins the groups the AI services need.
set -e
u=/etc/calamares/modules/users.conf
if [ -f "$u" ] && ! grep -q 'aiws' "$u"; then
  if grep -q '^defaultGroups:' "$u"; then
    sed -i '/^defaultGroups:/a\    - aiws\n    - render' "$u"
  else
    printf 'defaultGroups:\n    - users\n    - lp\n    - video\n    - render\n    - audio\n    - aiws\n    - sudo\n' >> "$u"
  fi
fi
