#!/bin/sh
# live-build configuration for the AI workstation. Run through build.sh, not directly.
set -e
. ./versions.env
. ./image.env
if [ "${REPRODUCIBLE:-0}" = 1 ]; then
  MIRROR="http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}"
  SECMIRROR="http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}"
else
  MIRROR="${MIRROR:-http://deb.debian.org/debian}"
  SECMIRROR="http://deb.debian.org/debian-security"
fi
USER_GROUPS="audio,cdrom,dip,floppy,video,render,plugdev,netdev,powerdev,scanner,bluetooth,sudo,aiws"

lb config noauto \
  --mode debian --distribution "$DEBIAN_SUITE" --architecture amd64 \
  --archive-areas "main contrib non-free-firmware" \
  --mirror-bootstrap "$MIRROR" --mirror-chroot "$MIRROR" \
  --mirror-chroot-security "$SECMIRROR" \
  --mirror-binary http://deb.debian.org/debian \
  --mirror-binary-security http://deb.debian.org/debian-security \
  --security true --updates true --backports true \
  --apt-recommends false \
  --linux-flavours amd64 \
  --firmware-chroot false --firmware-binary false \
  --binary-images iso-hybrid --bootloaders "syslinux,grub-efi" \
  --debian-installer none \
  --debootstrap-options "--include=ca-certificates" \
  --chroot-squashfs-compression-type zstd \
  --iso-application "Debian AI workstation" --iso-publisher "lab" \
  --iso-volume "$ISO_VOLUME" \
  --memtest none --source false --zsync false --checksums sha256 \
  --bootappend-live "boot=live components quiet splash username=$LIVE_USER hostname=aiws user-fullname=User user-default-groups=$USER_GROUPS" \
  "$@"
