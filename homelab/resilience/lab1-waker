#!/bin/sh
# Runs on lab3 every minute. If lab1 has been unreachable for 5 checks in a row
# and lab3 is on the home network, send lab1 a Wake-on-LAN magic packet.
LAB1=192.168.1.10
LAB1_MAC=18:60:24:e1:45:f4
HOME_GW_MAC=a8:a2:37:88:ac:2a
STATE=/run/lab1-waker.fails
gw=$(ip -4 route show default | awk '/192\.168\.1\./{print $3; exit}')
[ -n "$gw" ] || { rm -f $STATE; exit 0; }
ping -c1 -W1 "$gw" >/dev/null 2>&1
mac=$(ip neigh show "$gw" | awk '{for(i=1;i<=NF;i++) if($i=="lladdr") print $(i+1)}' | head -1)
[ "$mac" = "$HOME_GW_MAC" ] || { rm -f $STATE; exit 0; }      # not at home: nothing to do
if ping -c2 -W2 $LAB1 >/dev/null 2>&1; then rm -f $STATE; exit 0; fi
n=$(( $(cat $STATE 2>/dev/null || echo 0) + 1 )); echo $n > $STATE
if [ $n -ge 5 ] && [ $(( (n - 5) % 10 )) -eq 0 ]; then         # at 5 min, then every 10 min
  python3 - "$LAB1_MAC" <<'PY'
import socket,sys
mac=bytes.fromhex(sys.argv[1].replace(":","")); pkt=b"\xff"*6+mac*16
s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.setsockopt(socket.SOL_SOCKET,socket.SO_BROADCAST,1)
for port in (9,7): s.sendto(pkt,("192.168.1.255",port))
PY
  logger -t lab1-waker "lab1 unreachable for ${n} min, sent Wake-on-LAN"
fi
