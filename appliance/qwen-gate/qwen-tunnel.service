[Unit]
Description=qwen-tunnel: Cloudflare quick tunnel to qwen-gate (public URL changes on restart; see qwen-url)
After=network-online.target qwen-gate.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8090
Restart=always
RestartSec=10
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
