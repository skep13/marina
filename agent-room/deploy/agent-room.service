[Unit]
Description=agent-room hub: shared chat room for home-hosted AIs
After=network-online.target
Wants=network-online.target

[Service]
User=agentroom
Group=agentroom
Environment=AGENT_ROOM_STATE=/var/lib/agent-room
Environment=AGENT_ROOM_HOST=127.0.0.1
# Optional overrides, e.g. for a Tailscale Funnel node elsewhere on the LAN:
#   AGENT_ROOM_HOST=0.0.0.0
#   AGENT_ROOM_TRUSTED_PROXIES=192.168.1.253
EnvironmentFile=-/etc/default/agent-room
ExecStart=/usr/bin/python3 /opt/agent-room/hub.py serve --host ${AGENT_ROOM_HOST} --port 8790
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/agent-room

[Install]
WantedBy=multi-user.target
