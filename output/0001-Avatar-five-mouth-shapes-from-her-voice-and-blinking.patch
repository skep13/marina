From a4f1c8bf214ced54d9ce16e6a1577a79f1325b6b Mon Sep 17 00:00:00 2001
From: skep13 <skep13@users.noreply.github.com>
Date: Mon, 9 Nov 2026 21:23:02 +0000
Subject: [PATCH] Avatar: five mouth shapes from her voice, and blinking

The mouth used only 'aa'. Now the spectrum picks between aa, ih, ou, ee and
oh: energy low down is a round vowel, strong F2 a spread one, and hiss
(s, sh) keeps the mouth nearly closed. Openness still follows her loudness,
normalised as before. She also blinks every few seconds.
---
 client/index.html | 65 +++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 60 insertions(+), 5 deletions(-)

diff --git a/client/index.html b/client/index.html
index c9563d7..4dfd520 100644
--- a/client/index.html
+++ b/client/index.html
@@ -75,13 +75,51 @@
     controls.enableDamping = true;
     controls.dampingFactor = 0.08;  // lower = longer glide
 
-    // ── Lip sync: her mouth opens with the loudness of her voice ──
+    // ── Lip sync: how loud her voice is opens the mouth, and where the energy sits
+    //    in the spectrum picks the shape. Energy low down (F1) with little above it
+    //    is a round "oh"/"ou", strong F2 is a spread "ee"/"ih", in between is "aa". ──
     const voice = document.getElementById('voice');
     const audioCtx = new AudioContext();
     const analyser = audioCtx.createAnalyser();
+    analyser.fftSize = 1024;
+    analyser.smoothingTimeConstant = 0.35;
     audioCtx.createMediaElementSource(voice).connect(analyser);
     analyser.connect(audioCtx.destination);
     const samples = new Float32Array(analyser.fftSize);
+    const spectrum = new Uint8Array(analyser.frequencyBinCount);
+
+    // Average energy (0..1) between two frequencies.
+    function band(lowHz, highHz) {
+      const hzPerBin = audioCtx.sampleRate / analyser.fftSize;
+      const from = Math.round(lowHz / hzPerBin), to = Math.round(highHz / hzPerBin);
+      let sum = 0;
+      for (let i = from; i < to; i++) sum += spectrum[i];
+      return sum / ((to - from) * 255);
+    }
+
+    const clamp01 = (v) => Math.min(1, Math.max(0, v));
+    const SHAPES = ['aa', 'ih', 'ou', 'ee', 'oh'];  // the five VRM mouth expressions
+
+    // How much of each mouth shape she makes right now, for a mouth this open (0..1).
+    function mouthShapes(open) {
+      analyser.getByteFrequencyData(spectrum);
+      const f1 = band(250, 900), f2 = band(900, 2500), hiss = band(4000, 9000);
+      const front = f1 + f2 > 0.001 ? f2 / (f1 + f2) : 0.4;       // 0 = round, 1 = spread
+      const sibilant = f1 + f2 + hiss > 0.001 ? hiss / (f1 + f2 + hiss) : 0;
+      if (sibilant > 0.45) open *= 1 - (sibilant - 0.45) * 1.2;  // "s" and "sh" barely open it
+
+      const w = {
+        ee: clamp01((front - 0.58) * 3.4) + sibilant * 0.5,
+        ih: clamp01(1 - Math.abs(front - 0.52) * 4.2),
+        aa: clamp01(1 - Math.abs(front - 0.34) * 3.6) * (0.5 + open * 0.5),
+        oh: clamp01((0.36 - front) * 3.6),
+        ou: clamp01((0.28 - front) * 4.0) * (1.15 - open * 0.4),
+      };
+      const total = SHAPES.reduce((t, k) => t + w[k], 0);
+      const out = {};
+      for (const k of SHAPES) out[k] = total > 0.001 ? (w[k] / total) * open : (k === 'aa' ? open : 0);
+      return out;
+    }
 
     function loudness() {
       analyser.getFloatTimeDomainData(samples);
@@ -114,14 +152,31 @@
 
     // ── Every frame ──
     const clock = new THREE.Clock();
-    let mouth = 0;
+    const mouth = { aa: 0, ih: 0, ou: 0, ee: 0, oh: 0 };
     let loudest = 0.05;  // loudest recent level, so quiet and loud voices both move the mouth fully
+    let nextBlink = 2, blinkStart = -1;
     renderer.setAnimationLoop(() => {
+      const dt = clock.getDelta(), now = clock.elapsedTime;
+
       const level = loudness();
       loudest = Math.max(0.05, loudest * 0.995, level);
-      mouth += (level / loudest - mouth) * 0.5;  // smoothed so it does not flicker
-      vrm.expressionManager.setValue('aa', mouth);
-      vrm.update(clock.getDelta());
+      const open = level / loudest < 0.08 ? 0 : Math.pow(level / loudest, 1.35);
+      const target = mouthShapes(open);
+      for (const k of SHAPES) {
+        const speed = target[k] > mouth[k] ? 24 : 12;  // opens fast, closes a bit slower: no flicker
+        mouth[k] += (target[k] - mouth[k]) * Math.min(1, speed * dt);
+        vrm.expressionManager.setValue(k, mouth[k]);
+      }
+
+      // Blink every 2-6 seconds, now and then twice in a row.
+      if (now > nextBlink) {
+        blinkStart = now;
+        nextBlink = now + (Math.random() < 0.15 ? 0.3 : 2 + Math.random() * 4);
+      }
+      const b = (now - blinkStart) / 0.15;  // one blink takes 0.15 s
+      vrm.expressionManager.setValue('blink', b >= 0 && b < 1 ? Math.sin(b * Math.PI) : 0);
+
+      vrm.update(dt);
       controls.update();  // runs the glide
       renderer.render(scene, camera);
     });
-- 
