[Unit]
Description=PulseAudio with Marina's two virtual devices: dot_ear (what the Dot hears) and dot_mouth (what she says)

[Service]
ExecStart=/usr/bin/pulseaudio --daemonize=no --exit-idle-time=-1 --disallow-exit -n -F /opt/dot-bridge/dot.pa
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
