{
  "manifest_version": 3,
  "name": "Browser agent",
  "version": "0.2.2",
  "description": "A plain AI agent in the Firefox sidebar, running on lab3: reads pages, fills forms, works across tabs, and asks before submitting.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "sidebar_action": {
    "default_title": "Browser agent",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "open_at_install": true
  },
  "action": {
    "default_title": "Browser agent",
    "default_area": "navbar",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Open or close the browser agent"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-agent@skep13",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
